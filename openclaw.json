{
    "agents": {
        "defaults": {
            "workspace": "/app/workspace",
            "model": {
                "primary": "azure-openai-responses/gpt-5.4"
            }
        }
    },
    "commands": {
        "native": "auto",
        "nativeSkills": "auto",
        "restart": true,
        "ownerDisplay": "raw"
    },
    "gateway": {
        "mode": "remote",
        "controlUi": {
            "allowedOrigins": [
                "*"
            ]
        }
    }
}